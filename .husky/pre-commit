# Local pre-commit gate. Runs on the contributor's machine before every
# commit. Two checks — both aligned with the CI workflow so what passes
# locally also passes in CI.
#
# See NOTICE for the repository policy. Bypass with `git commit --no-verify`
# only if you have written owner authorization; CI will still enforce.

# ----------------------------------------------------------------------------
# 1) Commit-message check on the LAST commit trailer being staged.
#    (Prevents an obvious `Co-Authored-By:` attribution slipping in.)
#    This runs at prepare-commit-msg time in a full setup; we approximate by
#    checking the last commit and warning if the staged range is empty.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# 2) Staged-diff signature scan.
#    Reject if the staged diff contains obvious attribution comments left
#    behind by editing tools. Keeps the file body clean, not just the trailer.
# ----------------------------------------------------------------------------

pattern='(Co-Authored-By:[[:space:]]*(Claude|Copilot|Cursor|Codeium|Gemini|ChatGPT|GPT-[0-9]|OpenAI|Anthropic|Devin|Aider|Windsurf)|Generated with \[Claude Code\]|🤖 Generated with|// Generated by (Claude|Copilot|ChatGPT|Cursor|Gemini)|# Generated by (Claude|Copilot|ChatGPT|Cursor|Gemini))'

# Scan only the STAGED changes (what's about to be committed), lines added.
# `.husky/` is excluded because the hook definitions themselves must reference
# the patterns they are blocking.
staged=$(git diff --cached --unified=0 --no-color \
  -- ':(exclude)package-lock.json' \
  -- ':(exclude).husky' \
  -- ':(exclude).github/workflows' \
  | grep -E '^\+' | grep -Ev '^\+\+\+' || true)

if printf '%s\n' "$staged" | grep -iEq "$pattern"; then
  echo ""
  echo "✗ Commit blocked."
  echo ""
  echo "  Your staged changes contain an attribution trailer or comment that"
  echo "  identifies the code as third-party generated. This repository is"
  echo "  proprietary — see NOTICE for the full policy."
  echo ""
  echo "  Remove the offending line(s) from your staged changes and try again."
  echo "  If you have written owner authorization, bypass with:"
  echo "      git commit --no-verify"
  echo ""
  exit 1
fi
